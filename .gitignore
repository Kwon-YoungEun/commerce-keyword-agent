# 이 폴더 전용 Python 공간 — 용량이 크고 PC마다 경로가 달라 깃에 넣지 않습니다.
.venv/

# Claude Code 개인 설정 (토큰·개인 권한이 들어갈 수 있음)
.claude/settings.local.json

# 이 PC의 환경 점검 기록 — 사람마다 경로가 다릅니다.
.skb-setup-status.md

# Python 임시 파일
__pycache__/
*.py[cod]
*.egg-info/

# Office가 파일을 열어둘 때 만드는 임시 파일
~$*

# Windows·macOS가 만드는 폴더 정보 파일
desktop.ini
Thumbs.db
.DS_Store

# 다시 만들 수 있는 캐시 — 자동 커밋 때마다 전체 사본이 쌓여 저장소가 커집니다.
# 지워도 앱이 다시 받아옵니다.
commerce-keyword-agent/data/keyword_cache.json
commerce-keyword-agent/data/preview_cache.json
commerce-keyword-agent/data/tving_cache.json
commerce-keyword-agent/data/program_catalog.json

# 인코딩 점검용 임시 파일
commerce-keyword-agent/data/.enc_test

# 등록 API 인증 키 — 깃에 한 번 올라가면 기록에서 지우기 어렵습니다.
# 저장소가 비공개여도 넣지 않습니다.
commerce-keyword-agent/data/secrets.json

# 전송 기록 — 언제 무엇을 보냈는지만 남는 로컬 기록입니다.
commerce-keyword-agent/data/send_log.json

# 실적 데이터 — 다른 시스템에서 받아 온 것이라 저장소에 넣지 않습니다.
commerce-keyword-agent/data/performance.json

commerce-keyword-agent/data/airing_performance.json
